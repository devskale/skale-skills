#!/usr/bin/env bash
# visualize — render a set of things as ONE self-contained HTML document.
#
#   visualize open   <file.html>            # open an HTML file in the browser
#   visualize share  <file.html>            # upload to throway, print the URL
#   visualize validate <file.html>          # check it's self-contained (no external refs)
#   visualize --help
#
# The skill itself (see SKILL.md) is what *understands* the request and builds the
# HTML. This launcher is the plumbing: open locally, share to a URL, validate.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"

THROWAWAY="https://lubu.skale.dev/throway"

usage() {
    cat <<'EOF'
visualize — render a set of things as ONE self-contained HTML document.

Usage:
  visualize open <file.html>      # open the HTML in your browser (macOS / Linux / Windows)
  visualize share <file.html>     # upload to the throwaway store, print the URL
  visualize validate <file.html>  # verify the HTML is self-contained (no external refs)
  visualize --help                # this help

The agent builds the HTML (see SKILL.md). This launcher only opens, shares, validates.
EOF
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift

case "$cmd" in
    --help|-h) usage; exit 0 ;;

    open)
        [ $# -eq 1 ] || { echo "visualize open: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize open: not a file: $f" >&2; exit 2; }
        if command -v open >/dev/null 2>&1; then          # macOS
            open "$f"
        elif command -v xdg-open >/dev/null 2>&1; then    # Linux
            xdg-open "$f"
        elif command -v start >/dev/null 2>&1; then       # Windows (Git Bash)
            start "$f"
        else
            echo "visualize open: no opener found; open manually: $f" >&2
            exit 1
        fi
        echo "visualize: opened $f"
        ;;

    share)
        [ $# -eq 1 ] || { echo "visualize share: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize share: not a file: $f" >&2; exit 2; }
        name="$(basename "$f")"
        # Read the /api contract first (per the service's own instructions), then upload.
        curl -sf "$THROWAWAY/api" >/dev/null 2>&1 || echo "visualize: (couldn't read throway contract; proceeding)" >&2
        resp="$(curl -sf -X POST "$THROWAWAY/?name=$name" --data-binary @"$f")" \
            || { echo "visualize share: upload failed" >&2; exit 1; }
        # Extract the url field. Prefer python3 (json) for correctness.
        if command -v python3 >/dev/null 2>&1; then
            url="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
        fi
        [ -n "${url:-}" ] || url="$(printf '%s' "$resp" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
        [ -n "${url:-}" ] || { echo "visualize share: could not parse URL from response: $resp" >&2; exit 1; }
        echo "$url"
        echo "visualize: shared $name -> $url  (expires in ~4h)"
        ;;

    validate)
        [ $# -eq 1 ] || { echo "visualize validate: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize validate: not a file: $f" >&2; exit 2; }
        # Self-contained = no http(s) references to external styles/scripts/images.
        # (Ignoring the doctype/comment lines.) CDN references are the main offender.
        bad="$(grep -oE '(src|href)=["'"'"']https?://[^"'"'"']+' "$f" | grep -v 'cdn.tailwindcss.com' || true)"
        if [ -n "$bad" ]; then
            echo "visualize validate: NOT self-contained — external references found:" >&2
            echo "$bad" | sed 's/^/  /' >&2
            exit 1
        fi
        echo "visualize validate: OK — self-contained ($(wc -c < "$f" | tr -d ' ') bytes)"
        ;;

    *)
        echo "visualize: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
