#!/usr/bin/env bash
# visualize — render a set of things as ONE self-contained HTML document.
#
#   visualize open   <file.html>            # open an HTML file in the browser
#   visualize share  <file.html>            # upload to throway, print the URL, slop-lint (findings → exit 1)
#   visualize share  --update <file>        # share under a STABLE name (create-or-get) — same URL on repeat
#   visualize share  --dir <dir>            # upload a dir (recursively; nested files flattened)
#   visualize gate    <file.html>           # ALL gates parallel: validate + slop + chartcheck → exit 1 if any fails
#   visualize validate <file.html>          # check it's one file (local refs fail, popular CDNs ok)
#   visualize lint <file.html>              # style taste-gate: flag decorative AI-tells
#   visualize chartcheck <file.html>        # dataviz integrity gate (evident-charts influence)
#   visualize --help
#
# The skill itself (see SKILL.md) is what *understands* the request and builds the
# HTML. This launcher is the plumbing: open locally, share to a URL, validate.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"
AUTO_UPDATE_DAYS=7

# Enclosing git repo root (pi-package layout: <repo>/skills/<skill>/, .git is at ../..).
GIT_ROOT="$SKILL_DIR"
while [ -n "$GIT_ROOT" ] && [ ! -d "$GIT_ROOT/.git" ]; do
    GIT_ROOT="$(dirname "$GIT_ROOT" 2>/dev/null)"
    [ "$GIT_ROOT" = "/" ] && GIT_ROOT=""
done
GIT_ROOT="${GIT_ROOT:-$SKILL_DIR}"

THROWAWAY="https://lubu.skale.dev/throway"

# slop gate — every shared HTML gets linted against the amd slop API
# (fuzzy static AI-slop linter, /api/slop/lint). Findings after the upload:
# the URL is out (fast feedback), the findings are the to-do. Fix locally,
# re-share with --update (PUT in place, URL stable). Reviews are handed back
# for the agent to decide. Missing token or unreachable API skips the check
# (a share must never fail on the linter) — but says so.
SLOP_DIR_MAX=3   # share --dir lints at most this many html files
# Der slop-API-Vertrag (Endpoint, Auth, Report, Exit-Codes 0/1/3) lebt im
# Client: scripts/lib/slop_client.py — SLOP_API_URL ueberschreibt den
# Endpoint (Tests, Zweitmaschinen).

# Pin-Ledger: realpath → geteilte URL. Der Edit-Loop ist dann derselbe
# Befehl wie der erste Share: share → edit → share = PUT in place, gleiche
# URL (throway single uploads sind editable, verifiziert 2026-10).
SHARES_FILE="${HOME}/.config/visualize/shares.tsv"

# Percent-encode a query-param value (bash-only; keeps the RFC-3986 unreserved set,
# assumes ASCII filenames — slugs are the norm).
urlencode() {
    local s="$1" out="" c i h
    for (( i=0; i<${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) out+="$c" ;;
            *) printf -v h '%%%02X' "'$c"; out+="$h" ;;
        esac
    done
    printf '%s' "$out"
}

# Read the /api contract and USE it instead of discarding it (throway
# issue #1): the store's size limit turns a would-be blind 413 into a
# local, early, named failure. Empty output = contract unreadable;
# callers warn and proceed (best effort, as before).
throway_max_bytes() {
    curl -sf "$THROWAWAY/api" | python3 -c 'import sys,json
try: print(int(json.load(sys.stdin)["max_file_bytes"]))
except Exception: pass' 2>/dev/null
}
_too_big() {  # _too_big <file> <max> — exit 0 wenn die Datei ueber der Grenze liegt
    [ -n "${2:-}" ] || return 1
    [ "$(wc -c < "$1" | tr -d ' ')" -gt "$2" ]
}

# ── pin ledger (realpath → url) ────────────────────────────────────────────
_pin_get() {  # <realpath> → url (leer wenn ungepinnt)
    [ -f "$SHARES_FILE" ] || return 0
    awk -F'\t' -v k="$1" '$1 == k { print $2; exit }' "$SHARES_FILE"
}
_pin_set() {  # <realpath> <url>
    mkdir -p "$(dirname "$SHARES_FILE")"
    [ -f "$SHARES_FILE" ] && grep -vF "$(printf '%s\t' "$1")" "$SHARES_FILE" > "$SHARES_FILE.tmp" || : > "$SHARES_FILE.tmp"
    mv "$SHARES_FILE.tmp" "$SHARES_FILE"
    printf '%s\t%s\n' "$1" "$2" >> "$SHARES_FILE"
}

# _slop_check <file> — slop gate via slop_client (the one seam).
# Prints the client's --human report; exit codes pass through:
# 0 clean · 1 hardslop · 3 unverified. The client owns the API contract,
# token resolution (SLOP_TOKEN -> credgoo FETCH_URL_BEARER) and the
# offline hard-ban subset (SLOP_API_URL overrides the endpoint).
_slop_check() {
    python3 "$SKILL_DIR/scripts/lib/slop_client.py" lint "$1" --human
}

# ── Auto-update check (non-blocking) ──
if [ -d "$GIT_ROOT/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last_ts=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        [ $(( (now_ts - last_ts) / 86400 )) -ge "$AUTO_UPDATE_DAYS" ] && needs_update=true
    fi
    if $needs_update; then
        ( cd "$GIT_ROOT" && git pull --ff-only --quiet 2>/dev/null && date +%s > "$STAMP_FILE" ) &>/dev/null &
    fi
fi

usage() {
    cat <<'EOF'
visualize — render a set of things as ONE self-contained HTML document.

Usage:
  visualize open <file.html>      # open the HTML in your browser (macOS / Linux / Windows)
  visualize share <file.html>     # upload to the throwaway store, print the URL, slop-lint (findings → exit 1)
  visualize share --update <file> # share under a stable name (create-or-get) — same URL on repeat
  visualize share --dir <dir>     # upload a dir (recursively; nested files flattened)
  visualize gate <file.html>      # ALL gates parallel: validate + slop + chartcheck → exit 1 if any fails
  visualize validate <file.html>  # verify it's one file: local refs fail, popular CDNs ok
  visualize lint <file.html>      # style taste-gate: flag decorative AI-tells
  visualize chartcheck <file.html> # dataviz integrity gate: bar baseline, log scale, process notes, source
  visualize --help                # this help

The agent builds the HTML (see SKILL.md). This launcher only opens, shares, validates, lints, chartchecks.
EOF
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift

case "$cmd" in
    --help|-h) usage; exit 0 ;;

    --update|--self-update)
        echo "Updating visualize..."
        cd "$GIT_ROOT"
        git pull --ff-only 2>&1 || true
        date +%s > "$STAMP_FILE"
        echo "✓ Updated $(date)"
        exit 0
        ;;
    --selfcheck)
        vversion() { grep -m1 '^version:' "$SKILL_DIR/SKILL.md" 2>/dev/null | grep -o '[0-9][0-9.]*' || echo "?"; }
        last="never"
        if [ -f "$STAMP_FILE" ]; then
            ts="$(cat "$STAMP_FILE" 2>/dev/null)"
            last="$ts"
            # BSD date: -r <epoch>; GNU date: -d @<epoch>. Probe which one we have.
            case "$(date -r 0 '+%Y' 2>/dev/null)" in
                1970) last=$(date -r "$ts" "+%Y-%m-%d %H:%M" 2>/dev/null) ;;
                *)    last=$(date -d "@$ts" "+%Y-%m-%d %H:%M" 2>/dev/null) ;;
            esac
            [ -n "${last:-}" ] || last="$ts"
        fi
        echo "visualize v$(vversion)"
        echo "  dir:   $SKILL_DIR"
        echo "  last:  $last"
        echo "  curl:  $(command -v curl >/dev/null 2>&1 && echo yes || echo no)"
        exit 0
        ;;

    open)
        [ $# -eq 1 ] || { echo "visualize open: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize open: not a file: $f" >&2; exit 2; }
        if command -v open >/dev/null 2>&1; then          # macOS
            open "$f"
        elif command -v xdg-open >/dev/null 2>&1; then    # Linux
            xdg-open "$f"
        elif command -v cmd.exe >/dev/null 2>&1; then     # Git Bash / WSL
            # cmd's `start` is a builtin — command -v never finds it; go via cmd.exe.
            wpath="$f"
            command -v cygpath >/dev/null 2>&1 && wpath="$(cygpath -w "$f")"
            command -v wslpath >/dev/null 2>&1 && wpath="$(wslpath -w "$f")"
            cmd.exe /c start "" "$wpath"
        else
            echo "visualize open: no opener found; open manually: $f" >&2
            exit 1
        fi
        echo "visualize: opened $f"
        ;;

    share)
        # Edit-Loop: der zweite share derselben Datei = PUT in place (pin
        # ledger, realpath → url). --fresh erzwingt einen neuen Upload,
        # --update eine stabile /d/<slug>-URL (create-or-get), --dir ein
        # ganzes Verzeichnis. Slop-Gate läuft in allen Pfaden nach dem
        # Upload (URL zuerst, Befund danach; exit 0/1/3 durchgereicht).
        if [ "${1:-}" = "--fresh" ]; then fresh=1; shift; fi
        if [ -n "${2:-}" ]; then f="${2:-}"; rp="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"; fi
        # Dir mode: upload a whole directory as a browseable throway dir.
        if [ "${1:-}" = "--dir" ]; then
            d="${2:-}"
            [ -n "$d" ] && [ -d "$d" ] || { echo "visualize share --dir: expected a directory" >&2; exit 2; }
            rdp="$(cd "$d" && pwd)"
            # bestehenden dir-share wiederverwenden: gleicher Ordner = gleiche
            # /d/<id>-URL, Dateien werden per POST aktualisiert (PUT behandelt
            # throway dirs als replace-by-name — POST add/overwrite reicht)
            pinned_dir="$(_pin_get "$rdp")"
            if [ -n "$pinned_dir" ] && [ -z "${fresh:-}" ]; then
                dirurl="$pinned_dir"
            else
                resp="$(curl -sf -X POST "$THROWAWAY/?dir=1")" || { echo "visualize share --dir: create failed" >&2; exit 1; }
                dirurl="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
                [ -n "${dirurl:-}" ] || { echo "visualize share --dir: could not parse dir URL" >&2; exit 1; }
            fi
            maxb="$(throway_max_bytes)"
            [ -n "$maxb" ] || echo "visualize: (couldn't read throway contract; proceeding)" >&2
            # Upload every file under $d recursively. throway dirs are flat (files are
            # addressed as <key>/<name>), so nested files get their relative path folded
            # into the filename (sub/dir/f.txt → sub-dir-f.txt); collisions get -2/-3
            # suffixes before the extension. Bash 3.2-safe: no associative arrays.
            seen=""
            uniq_name() {
                local name="$1" base ext cand i=2
                base="${name%.*}"; ext="${name##*.}"
                [ "$base" = "$name" ] && ext=""
                cand="$name"
                while printf '%s' "$seen" | grep -qxF "$cand"; do
                    if [ -n "$ext" ]; then cand="$base-$i.$ext"; else cand="$base-$i"; fi
                    i=$((i+1))
                done
                printf '%s' "$cand"
            }
            n=0; failed=0; slop_bad=0; slop_checked=0
            while IFS= read -r -d '' f; do
                rel="${f#"$d"/}"
                name="$rel"
                [ "$name" = "$(basename "$rel")" ] || name="${rel//\//-}"
                name="$(uniq_name "$name")"
                seen="$seen$name"$'\n'
                if _too_big "$f" "$maxb"; then
                    failed=$((failed+1))
                    echo "visualize share --dir: over the store's max_file_bytes (${maxb:-?}): $rel" >&2
                    continue
                fi
                if curl -sf -X POST "$dirurl" -F "file=@$f;filename=$name" >/dev/null 2>&1; then
                    n=$((n+1))
                    # slop-gate the html files, capped at SLOP_DIR_MAX (one
                    # bad page must not turn a 50-file dir share into a
                    # 50-call lint run — the rest is opt-in via visualize lint)
                    case "$name" in
                        *.html|*.htm)
                            if [ "$slop_checked" -lt "$SLOP_DIR_MAX" ]; then
                                slop_checked=$((slop_checked+1))
                                _slop_check "$f" || slop_bad=$((slop_bad+1))
                            fi ;;
                    esac
                else
                    failed=$((failed+1))
                    echo "visualize share --dir: upload failed: $rel" >&2
                fi
            done < <(find "$d" -type f -print0)
            [ "$n" -gt 0 ] || { echo "visualize share --dir: no files uploaded" >&2; exit 1; }
            [ "$failed" -eq 0 ] || echo "visualize: $failed file(s) failed to upload — dir is incomplete" >&2
            [ -n "${rdp:-}" ] && _pin_set "$rdp" "$dirurl"
            echo "$dirurl"
            echo "visualize: shared dir '$d' -> $dirurl  ($n files, expires ~4h after last add)"
            [ "$slop_bad" -gt 0 ] && exit 1
            exit 0
        fi
        # --update: share under a STABLE name, then edit in place. Uses throway's own
        # &share=<slug> (create-or-get, sliding lifetime) + PUT to replace the file, so the
        # URL never changes and the edit history grows. Slug = base name sanitised to
        # [a-z0-9-], 5-32 chars, >=1 letter.
        if [ "${1:-}" = "--update" ]; then
            f="${2:-}"; [ -n "$f" ] && [ -f "$f" ] || { echo "visualize share --update: expected a file" >&2; exit 2; }
            base="$(basename "$f")"; base="${base%%.*}"
            slug="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/^-\+//; s/-\+$//')"
            [ -n "$slug" ] || slug="page"
            while [ "${#slug}" -lt 5 ]; do slug="$slug-p"; done
            slug="${slug:0:32}"
            # First call: &share= creates the named dir + file (idempotent).
            maxb="$(throway_max_bytes)"
            [ -n "$maxb" ] || echo "visualize: (couldn't read throway contract; proceeding)" >&2
            if _too_big "$f" "$maxb"; then
                echo "visualize share --update: $f is over the store's max_file_bytes ($maxb) — shrink the page (e.g. drop inline data)" >&2
                exit 1
            fi
            resp="$(curl -sf -X POST "$THROWAWAY/?name=$slug.html&share=$slug" --data-binary @"$f")" \
                || { echo "visualize share --update: upload failed" >&2; exit 1; }
            dirurl="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
            [ -n "${dirurl:-}" ] || dirurl="$THROWAWAY/d/$slug"
            _pin_set "$rp" "$dirurl/$slug.html"
            # PUT replaces the file in place (edit, not re-upload) — history grows, URL stable.
            curl -sf -X PUT "$THROWAWAY/d/$slug/$slug.html" --data-binary @"$f" >/dev/null 2>&1 \
                || { echo "visualize share --update: edit failed" >&2; exit 1; }
            echo "$dirurl"
            echo "visualize: shared (update) $f -> $dirurl  (stable URL; edit in place)"
            _slop_check "$f"
            rc=$?; [ $rc -ne 0 ] && exit $rc
            exit 0
        fi
        [ $# -eq 1 ] || { echo "visualize share: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize share: not a file: $f" >&2; exit 2; }
        name="$(basename "$f")"
        enc="$(urlencode "$name")"
        # Read the /api contract first (per the service's own instructions) —
        # and use it: fail locally, early and named when the file cannot fit,
        # instead of shipping 5MB for a blind 413 (throway issue #1).
        maxb="$(throway_max_bytes)"
        [ -n "$maxb" ] || echo "visualize: (couldn't read throway contract; proceeding)" >&2
        if _too_big "$f" "$maxb"; then
            echo "visualize share: $name is $(wc -c < "$f" | tr -d ' ') bytes — over the store's max_file_bytes ($maxb). Shrink the page (e.g. drop inline data) and retry." >&2
            exit 1
        fi
        rp="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
        if [ -z "${fresh:-}" ]; then
            pinned="$(_pin_get "$rp")"
            if [ -n "$pinned" ]; then
                if curl -sf -X PUT "$pinned" --data-binary @"$f" >/dev/null 2>&1; then
                    echo "$pinned"
                    echo "visualize: updated in place $f -> $pinned  (same URL, pin: $SHARES_FILE)"
                    _slop_check "$f"
                    rc=$?; [ $rc -ne 0 ] && exit $rc
                    exit 0
                fi
                echo "visualize: pin stale ($pinned) — re-uploading fresh" >&2
            fi
        fi
        resp="$(curl -sf -X POST "$THROWAWAY/?name=$enc" --data-binary @"$f")" \
            || { echo "visualize share: upload failed" >&2; exit 1; }
        # Extract the url field. Prefer python3 (json) for correctness.
        if command -v python3 >/dev/null 2>&1; then
            url="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
        fi
        [ -n "${url:-}" ] || url="$(printf '%s' "$resp" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
        [ -n "${url:-}" ] || { echo "visualize share: could not parse URL from response: $resp" >&2; exit 1; }
        _pin_set "$rp" "$url"
        echo "$url"
        echo "visualize: shared $name -> $url  (expires in ~4h; re-share updates in place, --fresh für neue URL)"
        _slop_check "$f"
        rc=$?; [ $rc -ne 0 ] && exit $rc
        exit 0
        ;;

    lint)
        [ $# -eq 1 ] || { echo "visualize lint: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize lint: not a file: $f" >&2; exit 2; }
        # slop gate via client: API-first (full engine), offline
        # faellt auf den hard-ban-Subset zurueck (exit codes 0/1/3).
        python3 "$SKILL_DIR/scripts/lib/slop_client.py" lint "$f" --human
        exit $?
        ;;

    chartcheck)
        [ $# -eq 1 ] || { echo "visualize chartcheck: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize chartcheck: not a file: $f" >&2; exit 2; }
        # Dataviz integrity gate. Evident-charts influence: a page can lie about
        # the data (truncated bar baseline, unlabelled log scale, TODO left on
        # the chart, a file name standing in for a publisher). Only what is
        # provable from the markup is checked - data-integrity rules need the
        # data, see references/chart-integrity.md. python3-less: skip, not block.
        if ! command -v python3 >/dev/null 2>&1; then
            echo "visualize chartcheck: python3 not found — install python3 for the dataviz gate" >&2
            exit 0   # kein python3 = kein blocking (best-effort, wie jscheck/node)
        fi
        exec python3 "$SKILL_DIR/scripts/chartcheck.py" "$f"
        ;;

    jscheck)
        [ $# -eq 1 ] || { echo "visualize jscheck: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize jscheck: not a file: $f" >&2; exit 2; }
        # JS quality gate: node --check auf jeden <script>-block + TDZ-heuristik
        # (befund 2026-09-27: 'Cannot access node before initialization' —
        # ein .on() vor der const-declaration lief unentdeckt durch validate)
        if ! command -v node >/dev/null 2>&1; then
            echo "visualize jscheck: node not found — install nodejs for the JS gate" >&2
            exit 0   # kein node = kein blocking (best-effort)
        fi
        tmpdir="$(mktemp -d)"
        trap 'rm -rf "$tmpdir"' EXIT
        found_err=0
        block=0
        # extrahiere inline <script>-blöcke (ohne src=)
        while IFS= read -r line; do
            if echo "$line" | grep -q '<script[[:space:]]*>'; then
                block=$((block+1))
                rm -f "$tmpdir/block.js"; touch "$tmpdir/block.js"
                in_block=1
                continue
            fi
            if echo "$line" | grep -q '</script>'; then
                in_block=0
                if [ -s "$tmpdir/block.js" ]; then
                    if ! node --check "$tmpdir/block.js" 2>/dev/null; then
                        echo "visualize jscheck: ✗ script-block #$block has a syntax error:" >&2
                        node --check "$tmpdir/block.js" 2>&1 | head -5 | sed 's/^/    /' >&2
                        found_err=1
                    fi
                fi
                continue
            fi
            [ -n "${in_block:-}" ] && [ "$in_block" = "1" ] && echo "$line" >> "$tmpdir/block.js"
        done < "$f"

        # TDZ-heuristik: variablen-nutzung vor const/let-declaration
        # (muster: `.on(` oder `.attr(` oder `.style(` auf eine variable
        #  die erst später als const/let deklariert wird)
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$f" <<'JSEOF'
import sys, re
src = open(sys.argv[1], encoding='utf-8', errors='replace').read()
scripts = re.findall(r'<script[^>]*>(.*?)</script>', src, re.DOTALL)
js = '\n'.join(s for s in scripts if 'src=' not in s[:50])
issues = []
# finde alle const/let deklarationen mit ihrer position
decls = {}
for m in re.finditer(r'\b(?:const|let)\s+([a-zA-Z_$][\w$]*)', js):
    name = m.group(1)
    if name not in decls:
        decls[name] = m.start()
# prüfe: wird die variable VOR ihrer deklaration mit .on(/.attr(/.style( genutzt?
for name, pos in decls.items():
    # suche nutzungen wie `name.on(`, `name.attr(`, `name.style(` vor pos
    for m in re.finditer(re.escape(name) + r'\.(?:on|attr|style|text|join|call)\s*\(', js[:pos]):
        # ist diese nutzung in einem anderen script-block oder kommentar?
        line_start = js.rfind('\n', 0, m.start()) + 1
        line = js[line_start:js.find('\n', m.start())]
        if '//' not in line[:m.start() - line_start]:
            issues.append(f'  TDZ: "{name}" used at pos {m.start()} before declaration at pos {pos}')
            issues.append(f'    line: {line.strip()[:80]}')
if issues:
    print('visualize jscheck: ✗ temporal-dead-zone violations:')
    for i in issues[:10]:
        print(i)
    sys.exit(1)
JSEOF
            [ $? -ne 0 ] && found_err=1
        fi

        if [ $found_err -eq 0 ]; then
            echo "visualize jscheck: OK — $block script blocks, no syntax errors, no TDZ violations"
        else
            echo "visualize jscheck: FAILED — fix the errors above" >&2
            exit 1
        fi
        ;;

    validate)
        [ $# -eq 1 ] || { echo "visualize validate: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize validate: not a file: $f" >&2; exit 2; }
        # One-file rule: the HTML is the only artifact. Dependencies (script/link/
        # img/iframe, CSS @import/url(), JS imports) must be inline or point at a
        # popular public CDN; plain <a href> is navigation and never counts.
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$f" <<'PYEOF'
import sys, re
path = sys.argv[1]
src = open(path, encoding='utf-8', errors='replace').read()

KNOWN_CDNS = ('cdn.tailwindcss.com', 'cdn.jsdelivr.net', 'unpkg.com',
              'cdnjs.cloudflare.com', 'esm.sh', 'cdn.skypack.dev',
              'fonts.googleapis.com', 'fonts.gstatic.com', 'cdn.plot.ly')

bad = []

def is_known(url):
    m = re.match(r'https?://([^/]+)', url)
    if not m:
        return False
    host = m.group(1).lower()
    return any(host == c or host.endswith('.' + c) for c in KNOWN_CDNS)

def check(kind, ref):
    ref = ref.strip()
    if not ref or ref.startswith(('#', 'data:', 'blob:')):
        return
    if ref.startswith(('http://', 'https://')):
        if not is_known(ref):
            bad.append(f'unknown external {kind}: {ref}')
    else:
        bad.append(f'local file reference in {kind} (breaks the single file): {ref}')

# 1. Dependency attributes — a plain <a href> is navigation, not a dependency.
for m in re.finditer(r'<(?:script|img|source|iframe|audio|video|embed|track)\b[^>]*?\ssrc="([^"]*)"', src):
    check('src', m.group(1))
for m in re.finditer(r'<link\b[^>]*?\shref="([^"]*)"', src):
    check('link href', m.group(1))

# 2. CSS @import and url() — <style> blocks and inline style attrs included.
#    SVG fragment refs (url(#id)) and data: URIs pass.
for m in re.finditer(r'@import\s+(?:url\(\s*)?["\']?([^)"\';\s]+)', src):
    check('css @import', m.group(1))
for m in re.finditer(r'url\(\s*["\']?([^"\')]+)["\']?\s*\)', src):
    check('css url()', m.group(1))

# 3. JS module imports from URLs (the mermaid-via-CDN pattern).
#    Only real <script> content counts: an `import ... from './x'` shown as prose inside
#    <code>/<pre> is *documentation of* an import, not a dependency the page loads.
#    Scanning the whole file flagged such snippets and made `validate` reject valid pages.
SCRIPTS = ' '.join(re.findall(r'<script\b[^>]*>(.*?)</script>', src, re.S | re.I))
for m in re.finditer(r'\bimport\s*["\']([^"\']+)["\']', SCRIPTS):
    check('js import', m.group(1))
for m in re.finditer(r'\bimport\s+[^"\';]*?\bfrom\s*["\']([^"\']+)["\']', SCRIPTS):
    check('js import', m.group(1))
for m in re.finditer(r'\bimport\s*\(\s*["\']([^"\']+)["\']', SCRIPTS):
    check('js import', m.group(1))

if bad:
    print('visualize validate: NOT a single file — dependency references found:')
    for line in dict.fromkeys(bad):
        print('  - ' + line)
    print('Popular CDNs are fine (' + ', '.join(KNOWN_CDNS[:5]) + ', ...).')
    print('Everything else: inline it or use a popular CDN; local sibling files always fail.')
    sys.exit(1)
else:
    print(f'visualize validate: OK — one file ({len(src)} bytes; content inline, CDN deps allowed)')
PYEOF
            # propagate the gate's verdict: without this the script fell through
            # to the jscheck run below, whose success reset the exit code to 0,
            # so a dependency violation exited clean (4 red validate tests).
            [ $? -ne 0 ] && exit 1
        else
            # python3-less fallback: basic grep for local + non-allowlisted deps
            KNOWNS='https?://(cdn\.tailwindcss\.com|cdn\.jsdelivr\.net|unpkg\.com|cdnjs\.cloudflare\.com|esm\.sh|cdn\.skypack\.dev|fonts\.googleapis\.com|fonts\.gstatic\.com|cdn\.plot\.ly)'
            bad="$(
                {
                    grep -oE '<(script|img|source|iframe|audio|video|embed|track|link)[^>]*\b(src|href)="[^"]+"' "$f" \
                        | grep -vE '(src|href)="(https?://|data:|#)'
                    grep -oE '<(script|img|source|iframe|audio|video|embed|track|link)[^>]*\b(src|href)="https?://[^"]+"' "$f" \
                        | grep -vE "$KNOWNS"
                    grep -oiE '@import[^;"]*' "$f" | grep -E 'https?://' | grep -vE "$KNOWNS"
                    grep -oiE 'url\(["'"'"']?https?://[^)"'"'"']+' "$f" | grep -vE "$KNOWNS"
                } | head -20
            )"
            if [ -n "$bad" ]; then
                echo "visualize validate: NOT a single file — dependency references found:" >&2
                echo "$bad" | sed 's/^/  /' >&2
                exit 1
            fi
            echo "visualize validate: OK — one file (basic check — install python3 for the full gate)"
        fi
        # JS quality gate läuft immer mit (befund 2026-09-27)
        "$0" jscheck "$f" || exit 1
        ;;

    gate)
        # Eine Interface über alle Gates — parallel innen (jeder Check liest
        # nur die Datei; Laufzeit ≈ langsamstes Gate, nicht die Summe).
        # Der Agent ruft EINEN Command statt sich vier zu merken; share
        # behält seinen URL-first-Slop-Check als letztes Netz.
        [ $# -eq 1 ] || { echo "visualize gate: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize gate: not a file: $f" >&2; exit 2; }
        tmpd="$(mktemp -d)"; trap 'rm -rf "$tmpd"' EXIT
        "$SELF" validate "$f" >"$tmpd/validate.out" 2>&1 & vpid=$!
        "$SELF" chartcheck "$f" >"$tmpd/chartcheck.out" 2>&1 & cpid=$!
        python3 "$SKILL_DIR/scripts/lib/slop_client.py" lint "$f" --human \
            >"$tmpd/slop.out" 2>&1 & spid=$!
        wait $vpid; vrc=$?
        wait $cpid; crc=$?
        wait $spid; src=$?
        fails=0
        for g in validate:$vrc slop:$src chartcheck:$crc; do
            gname="${g%%:*}"; grc="${g##*:}"
            if [ "$grc" -eq 0 ]; then
                echo "gate $gname: OK" >&2
            else
                fails=$((fails+1))
                echo "gate $gname: FAIL (exit $grc)" >&2
                cat "$tmpd/$gname.out" >&2
            fi
        done
        if [ $fails -gt 0 ]; then
            echo "visualize gate: $fails gate(s) failed" >&2
            exit 1
        fi
        echo "visualize gate: all gates pass" >&2
        ;;

    *)
        echo "visualize: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
