#!/usr/bin/env bash
# visualize — render a set of things as ONE self-contained HTML document.
#
#   visualize open   <file.html>            # open an HTML file in the browser
#   visualize share  <file.html>            # upload to throway, print the URL
#   visualize share  --dir <dir>            # upload a whole dir as a browseable throway dir
#   visualize validate <file.html>          # check it's self-contained (no external refs)
#   visualize lint <file.html>              # style taste-gate: flag AI-generated tells
#   visualize --help
#
# The skill itself (see SKILL.md) is what *understands* the request and builds the
# HTML. This launcher is the plumbing: open locally, share to a URL, validate.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"
AUTO_UPDATE_DAYS=7

THROWAWAY="https://lubu.skale.dev/throway"

# Percent-encode a query-param value (bash-only; keeps the RFC-3986 unreserved set,
# assumes ASCII filenames — slugs are the norm).
urlencode() {
    local s="$1" out="" c i h
    for (( i=0; i<${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) out+="$c" ;;
            *) printf -v h '%%%02X' "'$c"; out+="$h" ;;
        esac
    done
    printf '%s' "$out"
}

# ── Auto-update check (non-blocking) ──
if [ -d "$SKILL_DIR/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last_ts=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        [ $(( (now_ts - last_ts) / 86400 )) -ge "$AUTO_UPDATE_DAYS" ] && needs_update=true
    fi
    if $needs_update; then
        ( cd "$SKILL_DIR" && git pull --ff-only --quiet 2>/dev/null && date +%s > "$STAMP_FILE" ) &>/dev/null &
    fi
fi

usage() {
    cat <<'EOF'
visualize — render a set of things as ONE self-contained HTML document.

Usage:
  visualize open <file.html>      # open the HTML in your browser (macOS / Linux / Windows)
  visualize share <file.html>     # upload to the throwaway store, print the URL
  visualize share --dir <dir>     # upload a whole dir as a browseable throway dir
  visualize validate <file.html>  # verify the HTML is self-contained (no external refs)
  visualize lint <file.html>      # style taste-gate: flag AI-generated tells
  visualize --help                # this help

The agent builds the HTML (see SKILL.md). This launcher only opens, shares, validates, lints.
EOF
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift

case "$cmd" in
    --help|-h) usage; exit 0 ;;

    --update|--self-update)
        echo "Updating visualize..."
        cd "$SKILL_DIR"
        [ -d ".git" ] && git pull --ff-only 2>&1 || true
        date +%s > "$STAMP_FILE"
        echo "✓ Updated $(date)"
        exit 0
        ;;
    --selfcheck)
        vversion() { grep -m1 '^version:' "$SKILL_DIR/SKILL.md" 2>/dev/null | grep -o '[0-9][0-9.]*' || echo "?"; }
        last="never"
        if [ -f "$STAMP_FILE" ]; then
            ts="$(cat "$STAMP_FILE" 2>/dev/null)"
            last="$ts"
            # BSD date: -r <epoch>; GNU date: -d @<epoch>. Probe which one we have.
            case "$(date -r 0 '+%Y' 2>/dev/null)" in
                1970) last=$(date -r "$ts" "+%Y-%m-%d %H:%M" 2>/dev/null) ;;
                *)    last=$(date -d "@$ts" "+%Y-%m-%d %H:%M" 2>/dev/null) ;;
            esac
            [ -n "${last:-}" ] || last="$ts"
        fi
        echo "visualize v$(vversion)"
        echo "  dir:   $SKILL_DIR"
        echo "  last:  $last"
        echo "  curl:  $(command -v curl >/dev/null 2>&1 && echo yes || echo no)"
        exit 0
        ;;

    open)
        [ $# -eq 1 ] || { echo "visualize open: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize open: not a file: $f" >&2; exit 2; }
        if command -v open >/dev/null 2>&1; then          # macOS
            open "$f"
        elif command -v xdg-open >/dev/null 2>&1; then    # Linux
            xdg-open "$f"
        elif command -v start >/dev/null 2>&1; then       # Windows (Git Bash)
            start "$f"
        else
            echo "visualize open: no opener found; open manually: $f" >&2
            exit 1
        fi
        echo "visualize: opened $f"
        ;;

    share)
        # Dir mode: upload a whole directory as a browseable throway dir.
        if [ "${1:-}" = "--dir" ]; then
            d="${2:-}"
            [ -n "$d" ] && [ -d "$d" ] || { echo "visualize share --dir: expected a directory" >&2; exit 2; }
            curl -sf "$THROWAWAY/api" >/dev/null 2>&1 || echo "visualize: (couldn't read throway contract; proceeding)" >&2
            resp="$(curl -sf -X POST "$THROWAWAY/?dir=1")" || { echo "visualize share --dir: create failed" >&2; exit 1; }
            dirurl="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
            [ -n "${dirurl:-}" ] || { echo "visualize share --dir: could not parse dir URL" >&2; exit 1; }
            n=0; failed=0
            for f in "$d"/*; do
                [ -f "$f" ] || continue
                if curl -sf -X POST "$dirurl" -F "file=@$f" >/dev/null 2>&1; then
                    n=$((n+1))
                else
                    failed=$((failed+1))
                    echo "visualize share --dir: upload failed: $f" >&2
                fi
            done
            [ "$n" -gt 0 ] || { echo "visualize share --dir: no files uploaded" >&2; exit 1; }
            [ "$failed" -eq 0 ] || echo "visualize: $failed file(s) failed to upload — dir is incomplete" >&2
            echo "$dirurl"
            echo "visualize: shared dir '$d' -> $dirurl  ($n files, expires ~4h after last add)"
            exit 0
        fi
        [ $# -eq 1 ] || { echo "visualize share: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize share: not a file: $f" >&2; exit 2; }
        name="$(basename "$f")"
        enc="$(urlencode "$name")"
        # Read the /api contract first (per the service's own instructions), then upload.
        curl -sf "$THROWAWAY/api" >/dev/null 2>&1 || echo "visualize: (couldn't read throway contract; proceeding)" >&2
        resp="$(curl -sf -X POST "$THROWAWAY/?name=$enc" --data-binary @"$f")" \
            || { echo "visualize share: upload failed" >&2; exit 1; }
        # Extract the url field. Prefer python3 (json) for correctness.
        if command -v python3 >/dev/null 2>&1; then
            url="$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["url"])' 2>/dev/null)"
        fi
        [ -n "${url:-}" ] || url="$(printf '%s' "$resp" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"
        [ -n "${url:-}" ] || { echo "visualize share: could not parse URL from response: $resp" >&2; exit 1; }
        echo "$url"
        echo "visualize: shared $name -> $url  (expires in ~4h)"
        ;;

    lint)
        [ $# -eq 1 ] || { echo "visualize lint: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize lint: not a file: $f" >&2; exit 2; }
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$f" <<'PYEOF'
import sys, re
path = sys.argv[1]
src = open(path, encoding='utf-8', errors='replace').read()

# strip comments so hrefs inside html comments don't count
no_comments = re.sub(r'<!--.*?-->', '', src, flags=re.S)

warns = []

# Neutral ink/paper/muted palette — never counted as "saturated accent".
NEUTRAL = {'0f172a','1a1a1a','fafaf9','f4f4f5','ffffff','e4e4e7','e5e5e5',
           '6b7280','71717a','a1a1aa','e2e8f0','64748b','f8fafc','cbd5e1',
           '94a3b8','475569','334155','1e293b'}

def add(msg):
    warns.append(msg)

# 1. Saturated accent on links/buttons/TOC (teal/blue/indigo link text)
for m in re.finditer(r'<a[^>]*style="[^"]*color\s*:\s*#([0-9a-fA-F]{6})', no_comments):
    if m.group(1).lower() not in NEUTRAL:
        add('saturated accent on a link/button (inline color hex)')

# 2. Colored pill badges: border-radius:999px (either order) + a non-neutral hex background
for m in re.finditer(r'border-radius\s*:\s*99[0-9]px[^}]*?background\s*:\s*#[0-9a-fA-F]{6}|background\s*:\s*#[0-9a-fA-F]{6}[^}]*?border-radius\s*:\s*99[0-9]px', no_comments):
    seg = m.group(0)
    hb = re.search(r'background\s*:\s*(#[0-9a-fA-F]{6})', seg)
    if hb and hb.group(1).lower() not in ('ffffff','fafaf9','f4f4f5','e4e4e7','e5e5e5'):
        add('colored pill badge (border-radius:999px + non-neutral background)')

# 3. Colored numbered-circle badges on headings/steps
for m in re.finditer(r'border-radius\s*:\s*50%[^}]*?background\s*:\s*#[0-9a-fA-F]{6}|background\s*:\s*#[0-9a-fA-F]{6}[^}]*?border-radius\s*:\s*50%', no_comments):
    seg = m.group(0)
    hb = re.search(r'background\s*:\s*(#[0-9a-fA-F]{6})', seg)
    if hb and hb.group(1).lower() not in ('ffffff','fafaf9','f4f4f5','e4e4e7','e5e5e5'):
        add('colored numbered-circle badge (border-radius:50% + non-neutral background)')

# 4. Colored .ok/.bad pass-fail values
for m in re.finditer(r'class="[^"]*\b(?:ok|bad|pass|fail|success|danger|error)\b[^"]*"[^>]*style="[^"]*color\s*:\s*#[0-9a-fA-F]{6}', no_comments):
    add('colored .ok/.bad/pass-fail value (inline color)')

# 5. Saturated accent hex as text color (heuristic) — only inside CSS, not prose
#    Restrict to <style> blocks and inline style="..." attributes so hex in body
#    text (e.g. a page showing hex codes) isn't a false positive.
for m in re.finditer(r'<style[^>]*>(.*?)</style>', no_comments, flags=re.S):
    css = m.group(1)
    for cm in re.finditer(r'color\s*:\s*(#[0-9a-fA-F]{6})', css):
        hexv = cm.group(1).lower().lstrip('#')
        if hexv in NEUTRAL:
            continue
        add(f'saturated color used as text: #{hexv}')
for m in re.finditer(r'style="[^"]*color\s*:\s*(#[0-9a-fA-F]{6})', no_comments):
    hexv = m.group(1).lower().lstrip('#')
    if hexv in NEUTRAL:
        continue
    add(f'saturated color used as text: #{hexv}')

if warns:
    print('visualize lint: style taste-gate — potential AI-generated tells:')
    for w in dict.fromkeys(warns):
        print('  - ' + w)
    print('Fix these before sharing (see promptlib.md §0).')
    sys.exit(1)
else:
    print('visualize lint: OK — no AI-generated tells found')
PYEOF
        else
            # python3-less fallback: a few simple greps
            bad="$(grep -oE 'border-radius:99[0-9]px[^}]*background:#[0-9a-fA-F]{6}' "$f" | head -5)"
            if [ -n "$bad" ]; then
                echo "visualize lint: possible colored pill badges found:" >&2
                echo "$bad" | sed 's/^/  /' >&2
                exit 1
            fi
            echo "visualize lint: OK (basic check — install python3 for full taste-gate)" >&2
        fi
        ;;

    validate)
        [ $# -eq 1 ] || { echo "visualize validate: expected one file" >&2; exit 2; }
        f="$1"; [ -f "$f" ] || { echo "visualize validate: not a file: $f" >&2; exit 2; }
        # Self-contained = no http(s) references to external styles/scripts/images/fonts:
        # src/href attributes, CSS @import, and CSS url(). Known CDNs (tailwind, jsdelivr)
        # are allowed as documented runtime-network dependencies.
        bad="$(
            {
                grep -oE '(src|href)=["'"'"']https?://[^"'"'"']+' "$f" || true
                grep -oiE '@import[[:space:]]+(url\()?[[:space:]]*["'"'"']?https?://[^)"'"'"';[:space:]]+' "$f" || true
                grep -oiE 'url\([[:space:]]*["'"'"']?https?://[^)"'"'"']+\)' "$f" || true
            } | grep -vE 'cdn\.tailwindcss\.com|cdn\.jsdelivr\.net' || true
        )"
        if [ -n "$bad" ]; then
            echo "visualize validate: NOT self-contained — external references found:" >&2
            echo "$bad" | sed 's/^/  /' >&2
            exit 1
        fi
        echo "visualize validate: OK — self-contained ($(wc -c < "$f" | tr -d ' ') bytes)"
        ;;

    *)
        echo "visualize: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
