#!/usr/bin/env bash
# viewimg — show image(s) in the terminal (view-only, no VLM).
#
#   viewimg <image-file>... [--size WxH] [--open] [--no-color] [--help]
#
# Renders each image as ANSI block art via chafa (default), or opens ALL images
# together in ONE native window with `open` on macOS (--open). Never analyzes.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"
AUTO_UPDATE_DAYS=7

vversion() { grep -m1 '^version:' "$SKILL_DIR/SKILL.md" 2>/dev/null | grep -o '[0-9][0-9.]*' || echo "?"; }

case "${1:-}" in
    --update|--self-update)
        echo "Updating viewimg..."
        cd "$SKILL_DIR"
        [ -d ".git" ] && git pull --ff-only 2>&1 || true
        date +%s > "$STAMP_FILE"
        echo "✓ Updated $(date)"
        exit 0
        ;;
    --selfcheck)
        last="never"
        [ -f "$STAMP_FILE" ] && last=$(date -r "$STAMP_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null || cat "$STAMP_FILE")
        echo "viewimg v$(vversion)"
        echo "  dir:   $SKILL_DIR"
        echo "  last:  $last"
        echo "  chafa: $(command -v chafa >/dev/null 2>&1 && echo yes || echo no)"
        exit 0
        ;;
esac

# ── Auto-update check (non-blocking) ──
if [ -d "$SKILL_DIR/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last_ts=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        [ $(( (now_ts - last_ts) / 86400 )) -ge "$AUTO_UPDATE_DAYS" ] && needs_update=true
    fi
    if $needs_update; then
        ( cd "$SKILL_DIR" && git pull --ff-only --quiet 2>/dev/null && date +%s > "$STAMP_FILE" ) &>/dev/null &
    fi
fi

usage() {
    cat <<'EOF'
viewimg — show image(s) in the terminal (view-only, no VLM)

Usage:
  viewimg <image-file>... [--size WxH] [--open] [--no-color] [--help]

  --size WxH     chafa block size (default 60x30)
  --open         open ALL images together in ONE native window (macOS `open`)
  --no-color     plain ASCII fallback (no ANSI color)
  --help         this help

View-only: never analyzes the image. Understanding is opt-in (read_image / /readimg).
EOF
}

# ── parse args ──
files=(); size="60x30"; open_mode=0; no_color=0
while [ $# -gt 0 ]; do
    case "$1" in
        --size) size="${2:-60x30}"; shift 2 ;;
        --open) open_mode=1; shift ;;
        --no-color) no_color=1; shift ;;
        --help|-h) usage; exit 0 ;;
        --*) echo "viewimg: unknown flag: $1" >&2; usage >&2; exit 2 ;;
        *) files+=("$1"); shift ;;
    esac
done

[ "${#files[@]}" -gt 0 ] || { echo "viewimg: no image file given" >&2; usage >&2; exit 2; }
for f in "${files[@]}"; do
    [ -f "$f" ] || { echo "viewimg: not a file: $f" >&2; exit 2; }
done

# ── open ALL images in ONE native window ──
if [ "$open_mode" -eq 1 ]; then
    if command -v open >/dev/null 2>&1; then
        # `open -a Preview f1 f2 ...` opens all files as tabs in a single Preview
        # window, and Preview reuses that same window on later calls — so multiple
        # viewimg --open calls never stack up separate windows.
        open -a Preview "${files[@]}"
        echo "viewimg: opened ${#files[@]} image(s) in one Preview window"
        exit 0
    fi
    echo "viewimg: --open needs macOS \`open\` (not found)" >&2
    exit 1
fi

# ── in-terminal render via chafa (one per image) ──
if command -v chafa >/dev/null 2>&1; then
    for f in "${files[@]}"; do
        echo "== $f =="
        if [ "$no_color" -eq 1 ]; then
            chafa --format symbols --colors 2 --size "$size" "$f"
        else
            chafa --format symbols --colors 256 --size "$size" "$f"
        fi
    done
    exit 0
fi

# ── fallback: open all in one window ──
if command -v open >/dev/null 2>&1; then
    echo "viewimg: chafa not found — opening in a native window instead" >&2
    open -a Preview "${files[@]}"
    exit 0
fi
echo "viewimg: chafa not found. Install it (macOS: brew install chafa; Linux: apt install chafa)." >&2
exit 1
