#!/usr/bin/env bash
# s2m-queue — Show files pending metadata generation (no kategorie set)
# Usage:
#   s2m-queue                          # All projects, all bidders
#   s2m-queue PROJECT                  # Specific project, all bidders
#   s2m-queue PROJECT@BIDDER           # Specific bidder
set -euo pipefail
cd ~/code/python-utils/packages/strukt2meta
exec uv run python - "$@" << 'PYEOF'
import sys, json
import ofs

def show(target):
    if '@' in target:
        idx = target.index('@')
        project = target[:idx]
        bidder = target[idx+1:] if idx+1 < len(target) else None
    else:
        project = target
        bidder = None

    if project == 'all':
        projects = ofs.list_projects()
    else:
        projects = [project]

    for proj in projects:
        if not bidder:
            docs = ofs.list_project_docs_json(proj)
            docs = docs.get('documents', []) if isinstance(docs, dict) else docs
            for d in docs:
                if not d.get('kategorie'):
                    print(f'❌ {proj}/A/{d["name"]}')
        bidders = ofs.list_bidders(proj)
        for b in bidders:
            if bidder and bidder != b:
                continue
            bdocs = ofs.list_bidder_docs_json(proj, b)
            bdocs = bdocs.get('documents', []) if isinstance(bdocs, dict) else bdocs
            for d in bdocs:
                if not d.get('kategorie'):
                    print(f'❌ {proj}/{b}/{d["name"]}')

show(sys.argv[1] if len(sys.argv) > 1 else 'all')
PYEOF
