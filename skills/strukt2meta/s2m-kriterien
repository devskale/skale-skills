#!/usr/bin/env bash
# s2m-kriterien — Extract criteria from tender documents (3-step pipeline)
# Usage:
#   s2m-kriterien PROJECT meta          # Step 1: tender metadata, lots, evaluation principle
#   s2m-kriterien PROJECT bdoks         # Step 2: required bidder documents
#   s2m-kriterien PROJECT ids           # Step 3: all criteria with IDs
#   s2m-kriterien PROJECT meta -v       # Verbose
set -euo pipefail
cd ~/code/python-utils/packages/strukt2meta
if [ $# -lt 2 ]; then
    echo "Usage: s2m-kriterien PROJECT {meta|bdoks|ids} [-v]"
    exit 1
fi
PROJECT="$1"
STEP="$2"
shift 2
exec uv run strukt2meta ofs "$PROJECT" --mode kriterien --step "$STEP" "$@"
