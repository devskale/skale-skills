#!/usr/bin/env bash
# vtd — Video Transcript Downloader (yt-dlp + youtube-transcript-plus)
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"

# ── Python venv for yt-dlp (kept OUTSIDE the repo) ──
# pi's package update runs `git clean -fdx`, which deletes ANY untracked/
# gitignored file inside the package — including an in-repo `.venv/`. Keep the
# venv in the cache dir so updates never wipe it. scripts/vtd.js resolves the
# yt-dlp binary from VTD_ENV_DIR. See docs/agent-skills-best-practices.md →
# Python dependencies & pi package updates.
ENV_DIR="${VTD_ENV_DIR:-$HOME/.cache/skale-skills/video-transcript-downloader}"
export VTD_ENV_DIR="$ENV_DIR"

install_ytdlp() {
    command -v uv &>/dev/null || return 0
    if [ ! -x "$ENV_DIR/bin/yt-dlp" ] && [ ! -x "$ENV_DIR/Scripts/yt-dlp.exe" ]; then
        uv venv "$ENV_DIR" &>/dev/null || true
    fi
    local py="$ENV_DIR/bin/python"
    [ -x "$py" ] || py="$ENV_DIR/Scripts/python.exe"
    [ -x "$py" ] && uv pip install --python "$py" yt-dlp &>/dev/null || true
}

case "${1:-}" in
    --update|--self-update)
        cd "$SKILL_DIR"
        echo "Updating video-transcript-downloader..."
        [ -d ".git" ] && git pull --ff-only 2>&1 || true
        install_ytdlp
        date +%s > "$STAMP_FILE"
        echo "Updated."
        exit 0
        ;;
    --selfcheck)
        version=$(grep '"version"' package.json 2>/dev/null | grep -o '[0-9][0-9.]*' || echo "?")
        last=""
        [ -f "$STAMP_FILE" ] && last=$(date -r "$STAMP_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null || stat -f "%Sm" "$STAMP_FILE" 2>/dev/null || echo "never")
        has_node=$([ -d "$SKILL_DIR/node_modules" ] && echo "yes" || echo "no")
        has_venv=$([ -x "$ENV_DIR/bin/yt-dlp" ] || [ -x "$ENV_DIR/Scripts/yt-dlp.exe" ] || [ -d "$SKILL_DIR/.venv" ] && echo "yes" || echo "no")
        echo "vtd v${version}"
        echo "  dir:  $SKILL_DIR"
        echo "  last: ${last}"
        echo "  node: $has_node"
        echo "  venv: $has_venv ($ENV_DIR)"
        exit 0
        ;;
    --install)
        cd "$SKILL_DIR"
        echo "Installing video-transcript-downloader..."
        mkdir -p "$HOME/.local/bin"
        # Python venv for yt-dlp (outside the repo)
        install_ytdlp
        # Node deps
        if command -v pnpm &>/dev/null; then
            pnpm install 2>/dev/null
        elif command -v npm &>/dev/null; then
            npm install 2>/dev/null
        fi
        ln -sf "$SKILL_DIR/vtd" "$HOME/.local/bin/vtd"
        date +%s > "$STAMP_FILE"
        echo "Done. Use: vtd transcript --url 'https://...'"
        exit 0
        ;;
esac

# Auto-update after 7 days
if [ -f "$STAMP_FILE" ]; then
    last=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
    now=$(date +%s)
    age=$(( (now - last) / 86400 ))
    if [ "$age" -gt 7 ]; then
        (cd "$SKILL_DIR" && git pull --ff-only --quiet 2>/dev/null && install_ytdlp && date +%s > "$STAMP_FILE") &>/dev/null &
    fi
fi

# Capture where the user invoked us BEFORE we cd into the skill dir.
# The default --transcript-dir (./transcripts/) resolves relative to THIS
# directory, not the skill dir, so downloads land where the user expects.
export VTD_INVOKED_PWD="$PWD"

cd "$SKILL_DIR" && exec node scripts/vtd.js "$@"
