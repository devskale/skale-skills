#!/usr/bin/env bash
# d2v — render + self-verify a .d2 diagram in one command.
#
#   bash scripts/d2v diagram.d2 [out.svg] [-- <d2 flags>]
#
# Pipeline:
#   1. d2 validate          grammar gate (fail → exit 1)
#   2. d2 … .txt            ASCII structure to STDERR (always-on) — also the real compile
#                           check (unknown shapes / bad styles error here) → exit 1 on failure
#   3. d2 … .svg [flags]    render the deliverable; STDOUT = the .svg path (pipeable)
#   4. width-bloat check    width:height > 2.2 → warning to stderr (non-blocking)
#
# Anything after `--` is forwarded to the SVG render only (e.g. `-- --sketch --theme 4`),
# so you can apply visual freshness (sketch/themes) without losing the structure checks.
# (Sketch is CLI-only — `vars: d2-config: sketch` is ignored — hence the passthrough.)
#
# Exit 0 clean; 1 on validate/compile/render failure; 2 on bad usage.
# STDERR carries the ASCII preview + warnings/errors; STDOUT carries only the svg path.
set -uo pipefail

BLOAT_RATIO=2.2

# ── parse args: src [out] -- <extras forwarded to d2 svg render> ──
src=""; out=""; extras=(); seen=0
for a in "$@"; do
  if [ "$a" = "--" ]; then seen=1; continue; fi
  if [ $seen -eq 1 ]; then extras+=("$a"); continue; fi
  if [ -z "$src" ]; then src="$a"; elif [ -z "$out" ]; then out="$a"; fi
done

[ -n "$src" ] || { echo "usage: d2v <diagram.d2> [out.svg] [-- <d2 flags>]" >&2; exit 2; }
[ -f "$src" ] || { echo "d2v: not a file: $src" >&2; exit 2; }
out="${out:-${src%.d2}.svg}"

# 1. Grammar gate (permissive — doesn't catch unknown shapes/styles, but cheap).
if ! d2 validate "$src" >/dev/null 2>&1; then
  echo "✗ d2 validate failed:" >&2
  d2 validate "$src" >&2
  exit 1
fi

# 2. ASCII structure → stderr. Also the real compile check: render-to-txt fails identically
#    to .svg on unknown shapes / invalid styles, so we catch those here.
tmp="$(mktemp -t d2v.XXXXXX).txt"
if ! d2 "$src" "$tmp" >/dev/null 2>&1; then
  echo "✗ compile failed (render to .txt):" >&2
  d2 "$src" "$tmp" >&2
  rm -f "$tmp"
  exit 1
fi
echo "── ASCII structure (verify edges/nodes) ──" >&2
cat "$tmp" >&2
echo "──────────────────────────────────────────" >&2
rm -f "$tmp"

# 3. Render the deliverable SVG (extras forwarded here only — they're visual: sketch/theme/…).
if ! d2 "$src" "$out" ${extras[@]+"${extras[@]}"} >/dev/null 2>&1; then
  echo "✗ SVG render failed:" >&2
  d2 "$src" "$out" ${extras[@]+"${extras[@]}"} >&2
  exit 1
fi

# 4. Width-bloat check (the one layout problem detectable without vision).
wh=$(grep -oE 'width="[0-9]+" height="[0-9]+"' "$out" | head -1)
w=${wh//*width=\"/}; w=${w%% *}; w=${w%%\"*}
h=${wh//*height=\"/}; h=${h%%\"*}
if [ -n "$w" ] && [ -n "$h" ] && [ "$h" -gt 0 ] 2>/dev/null; then
  ratio=$(awk -v w="$w" -v h="$h" 'BEGIN{printf "%.2f", w/h}')
  warn=$(awk -v r="$ratio" -v b="$BLOAT_RATIO" 'BEGIN{print (r>b)?1:0}')
  if [ "$warn" = "1" ]; then
    echo "⚠ width:height ${w}:${h} (ratio ${ratio} > ${BLOAT_RATIO}) — renders compressed; trim labels, drop side branches, or switch direction" >&2
  fi
fi

echo "$out"
