#!/usr/bin/env bash
# pdf2md launcher with symlink resolution + auto-update
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"
AUTO_UPDATE_DAYS=7

# Enclosing git repo root (pi-package layout: <repo>/skills/<skill>/, .git is at ../..).
GIT_ROOT="$SKILL_DIR"
while [ -n "$GIT_ROOT" ] && [ ! -d "$GIT_ROOT/.git" ]; do
    GIT_ROOT="$(dirname "$GIT_ROOT" 2>/dev/null)"
    [ "$GIT_ROOT" = "/" ] && GIT_ROOT=""
done
GIT_ROOT="${GIT_ROOT:-$SKILL_DIR}"

# ── Dependency environment (kept OUTSIDE the repo) ──
# pi's package update runs `git clean -fdx`, which deletes ANY untracked/
# gitignored file inside the package — including a `.venv/` created by `uv sync`.
# Point uv's project environment at a cache dir instead so the skill stays
# pristine and updates never wipe the virtualenv.
ENV_DIR="${UV_PROJECT_ENVIRONMENT:-$HOME/.cache/skale-skills/pdf2md}"
export UV_PROJECT_ENVIRONMENT="$ENV_DIR"

# ── Handle launcher-only flags ──
case "${1:-}" in
    --update)
        echo "Updating pdf2md..."
        cd "$GIT_ROOT"
        git pull --ff-only 2>&1 || true
        (cd "$SKILL_DIR" && uv sync --quiet 2>&1)
        date +%s > "$STAMP_FILE"
        echo "✓ Updated $(date)"
        exit 0
        ;;
    --selfcheck)
        version=$(grep -o 'version.*"[^"]*"' "$SKILL_DIR/pyproject.toml" 2>/dev/null | head -1 | grep -o '[0-9][^"]*' || echo "?")
        last="never"
        [ -f "$STAMP_FILE" ] && last=$(date -r "$STAMP_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null || cat "$STAMP_FILE")
        echo "pdf2md v${version}"
        echo "  dir:  $SKILL_DIR"
        echo "  last: $last"
        exit 0
        ;;
esac

# ── Auto-update check (non-blocking) ──
if [ -d "$GIT_ROOT/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last_ts=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        [ $(( (now_ts - last_ts) / 86400 )) -ge "$AUTO_UPDATE_DAYS" ] && needs_update=true
    fi
    if $needs_update; then
        (
            cd "$GIT_ROOT"
            git pull --ff-only --quiet 2>/dev/null
            (cd "$SKILL_DIR" && uv sync --quiet 2>/dev/null)
            date +%s > "$STAMP_FILE"
        ) &>/dev/null &
    fi
fi

# ── Run ──
# --project keeps the caller's cwd: relative input/output paths resolve
# against the directory the user is in, not the skill dir
exec uv run --project "$SKILL_DIR" "$SKILL_DIR/scripts/pdf2md.py" "$@"
