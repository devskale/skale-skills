#!/usr/bin/env bash
# youtube — Search YouTube videos via Invidious API
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
STAMP_FILE="$SKILL_DIR/.last-update"

# Enclosing git repo root (pi-package layout: <repo>/skills/<skill>/, .git is at ../..).
GIT_ROOT="$SKILL_DIR"
while [ -n "$GIT_ROOT" ] && [ ! -d "$GIT_ROOT/.git" ]; do
    GIT_ROOT="$(dirname "$GIT_ROOT" 2>/dev/null)"
    [ "$GIT_ROOT" = "/" ] && GIT_ROOT=""
done
GIT_ROOT="${GIT_ROOT:-$SKILL_DIR}"

# ── Dependency environment (kept OUTSIDE the repo) ──
# pi's package update runs `git clean -fdx`, which wipes any `.venv/` inside
# the package. Point uv at a cache dir so the skill stays pristine and updates
# never delete the virtualenv (docs/agent-skills-best-practices.md).
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$HOME/.cache/skale-skills/youtube}"

case "${1:-}" in
    --update|--self-update)
        cd "$SKILL_DIR"
        echo "Updating youtube..."
        if ! (cd "$GIT_ROOT" && git -c pull.rebase=false pull --ff-only); then
            echo "✗ git pull failed — staying on current code, stamp NOT updated" >&2
            exit 1
        fi
        (cd "$SKILL_DIR" && uv sync --quiet)
        date +%s > "$STAMP_FILE"
        echo "Updated."
        exit 0
        ;;
    --selfcheck)
        version=$(grep 'version' "$SKILL_DIR/pyproject.toml" 2>/dev/null | head -1 | grep -o '[0-9][0-9.]*' || echo "?")
        last=""
        [ -f "$STAMP_FILE" ] && last=$(date -r "$STAMP_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null || stat -f "%Sm" "$STAMP_FILE" 2>/dev/null || echo "never")
        echo "youtube v${version}"
        echo "  dir:  $SKILL_DIR"
        echo "  last: ${last}"
        exit 0
        ;;
    --install)
        cd "$SKILL_DIR"
        if command -v uv &>/dev/null; then
            uv sync --quiet 2>/dev/null
        fi
        ln -sf "$SKILL_DIR/youtube" "$HOME/.local/bin/youtube" 2>/dev/null || true
        date +%s > "$STAMP_FILE"
        echo "Installed."
        exit 0
        ;;
esac

# Auto-update after 7 days (or when the stamp is missing — fresh git clone)
if [ -d "$GIT_ROOT/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now=$(date +%s)
        [ $(( (now - last) / 86400 )) -gt 7 ] && needs_update=true
    fi
    if $needs_update; then
        # Hard rule (AGENTS.md): failures are loud, never silenced. stdout is
        # discarded, stderr stays attached; NO stamp on failure → next run retries.
        (
            cd "$GIT_ROOT" || exit 1
            ok=true
            if ! git -c pull.rebase=false pull --ff-only --quiet; then
                echo "youtube: auto-update git pull failed — staying on current code, will retry next run" >&2
                ok=false
            fi
            if $ok && ! (cd "$SKILL_DIR" && uv sync --quiet); then
                echo "youtube: auto-update uv sync failed — staying on current code, will retry next run" >&2
                ok=false
            fi
            $ok && date +%s > "$STAMP_FILE"
        ) >/dev/null &
    fi
fi

# ── Run (from the caller's cwd — search.py writes ./lists/ relative to cwd) ──
exec uv run --project "$SKILL_DIR" "$SKILL_DIR/scripts/search.py" "$@"
