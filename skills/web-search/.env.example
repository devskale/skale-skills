# Web Search Skill Environment Variables
# Copy this file to .env and set your actual bearer token

# Method 1: DuckDuckGo - Set bearer token directly
# WEB_SEARCH_BEARER=your_bearer_token_here

# Method 2: SearXNG - Use credgoo for secure credentials (recommended)
# Install credgoo once (global CLI):
#   uv tool install "credgoo @ git+https://github.com/devskale/python-openutils.git#subdirectory=packages/credgoo"
# Then retrieve the shared team SearXNG instance:
#   credgoo searx        # Returns: URL@username@password
#
# The skill will automatically use SearXNG if credentials are available.
