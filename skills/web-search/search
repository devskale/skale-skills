#!/usr/bin/env bash
# web-search launcher with symlink resolution + auto-update + credgoo health check
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SKILL_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# Fallback: when this launcher is a copy (not a real symlink) outside the
# skill directory — e.g. on Windows git-bash where ln -s produces a copy
# instead of a native symlink — resolve the skill location by probing agent
# skill directories, standard-first. The launcher's own name doubles as the
# skill name. Probes, in order:
#   1. ~/.agents/skills/<name>   (agentskills.io standard — most agents)
#   2. ~/.pi/agent/skills/<name>  (pi's global skill dir)
#   3. ~/.claude/skills/<name> · ~/.codex/skills/<name> (other agents)
# pi stays a first-class probe target; the standard dir simply comes first
# because every spec-compliant agent (pi included) reads it.
if [ ! -f "$SKILL_DIR/scripts/search.py" ]; then
    _name="$(basename "$0")"
    for _try in \
        "$HOME/.agents/skills/$_name" \
        "$HOME/.pi/agent/skills/$_name" \
        "$HOME/.claude/skills/$_name" \
        "$HOME/.codex/skills/$_name"; do
        if [ -f "$_try/scripts/search.py" ]; then
            SKILL_DIR="$(cd "$_try" && pwd -P)"
            break
        fi
    done
fi
STAMP_FILE="$SKILL_DIR/.last-update"
AUTO_UPDATE_DAYS=7

# Resolve the enclosing git repo root (pi-package layout: <repo>/skills/<skill>/,
# so .git lives at ../.. — not inside the skill dir). Falls back to SKILL_DIR when
# there's no enclosing repo. Used by --update and auto-update.
GIT_ROOT="$SKILL_DIR"
while [ -n "$GIT_ROOT" ] && [ ! -d "$GIT_ROOT/.git" ]; do
    GIT_ROOT="$(dirname "$GIT_ROOT" 2>/dev/null)"
    [ "$GIT_ROOT" = "/" ] && GIT_ROOT=""
done
GIT_ROOT="${GIT_ROOT:-$SKILL_DIR}"

# ── Dependency environment (kept OUTSIDE the repo) ──
# pi's package update runs `git clean -fdx`, which deletes ANY untracked/
# gitignored file inside the package — including a `.venv/` created by `uv sync`.
# Point uv's project environment at a cache dir instead so the skill stays
# pristine and updates never wipe the virtualenv. See
# docs/agent-skills-best-practices.md → Python dependencies & pi package updates.
ENV_DIR="${UV_PROJECT_ENVIRONMENT:-$HOME/.cache/skale-skills/web-search}"
export UV_PROJECT_ENVIRONMENT="$ENV_DIR"

# ── Handle launcher-only flags ──
case "${1:-}" in
    --update)
        echo "Updating web-search..."
        cd "$GIT_ROOT" || exit 1
        if ! git -c pull.rebase=false pull --ff-only 2>&1; then
            echo "✗ git pull failed — staying on current code, stamp NOT updated" >&2
            exit 1
        fi
        if ! (cd "$SKILL_DIR" && uv sync 2>&1); then
            echo "✗ uv sync failed — code updated but deps may be stale" >&2
            exit 1
        fi
        date +%s > "$STAMP_FILE"
        echo "✓ Updated $(date)"
        exit 0
        ;;
    --selfcheck)
        version=$(grep -o 'version.*"[^"]*"' "$SKILL_DIR/pyproject.toml" 2>/dev/null | head -1 | grep -o '[0-9][^"]*' || echo "?")
        last="never"
        [ -f "$STAMP_FILE" ] && last=$(date -r "$STAMP_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null || cat "$STAMP_FILE")
        echo "web-search v${version}"
        echo "  dir:  $SKILL_DIR"
        echo "  last: $last"
        echo ""
        echo "credgoo:"
        if command -v credgoo >/dev/null 2>&1; then
            echo "  version: $(credgoo --version 2>&1)"
            receipt="$HOME/.local/share/uv/tools/credgoo/uv-receipt.toml"
            if [ -f "$receipt" ]; then
                if grep -q 'directory = ' "$receipt"; then
                    echo "  source:  ✗ local path (FROZEN — won't auto-update; reinstall from git, see below)"
                elif grep -q 'git = ' "$receipt"; then
                    echo "  source:  ✓ git (upgradeable: uv tool upgrade credgoo)"
                else
                    echo "  source:  ? unknown"
                fi
            fi
            for svc in searx WEB_SEARCH_BEARER; do
                if key=$(credgoo "$svc" 2>/dev/null) && [ -n "$key" ]; then
                    echo "  $svc: ✓"
                else
                    echo "  $svc: ✗ (credgoo returned no key)"
                fi
            done
        else
            echo "  ✗ not installed"
            echo "    uv tool install \"credgoo @ git+https://github.com/devskale/python-openutils.git#subdirectory=packages/credgoo\""
        fi
        exit 0
        ;;
esac

# ── Auto-update check (non-blocking) ──
if [ -d "$GIT_ROOT/.git" ]; then
    needs_update=false
    if [ ! -f "$STAMP_FILE" ]; then
        needs_update=true
    else
        last_ts=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)
        now_ts=$(date +%s)
        [ $(( (now_ts - last_ts) / 86400 )) -ge "$AUTO_UPDATE_DAYS" ] && needs_update=true
    fi
    if $needs_update; then
        # Auto-update: non-blocking, but NOT silent on failure. stdout is
        # discarded, stderr stays attached — a failed pull/sync warns on
        # stderr and does NOT write the stamp, so the next run retries
        # (loudly) instead of hiding the breakage for AUTO_UPDATE_DAYS.
        # Hard rule (AGENTS.md): failures must be loud, never silenced.
        (
            cd "$GIT_ROOT" || exit 1
            ok=true
            if ! git -c pull.rebase=false pull --ff-only --quiet; then
                echo "web-search: auto-update git pull failed — staying on current code, will retry next run" >&2
                ok=false
            fi
            if $ok && ! (cd "$SKILL_DIR" && uv sync --quiet); then
                echo "web-search: auto-update uv sync failed — staying on current code, will retry next run" >&2
                ok=false
            fi
            $ok && date +%s > "$STAMP_FILE"
        ) >/dev/null &
    fi
fi

# ── Run ──
cd "$SKILL_DIR" && exec uv run scripts/search.py "$@"
