#!/usr/bin/env bash
# pre-push: FAST by default — lint + typecheck only (2s). Deeper checks are opt-in.
#
#   git push             # lint + typecheck only (the fast default)
#   CHECK=1 git push     # fast gate (+ skill-metadata + docs integrity)
#   RELEASE=1 git push   # full regression (all per-skill suites, slow, some network)
#   PUSH_SKIP_TESTS=1 git push # skip everything (WIP escape hatch)
#
# Depth ladder (fastest → deepest): lint → check → check --full. Default is the fastest.

set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"

if [ "${PUSH_SKIP_TESTS:-0}" = "1" ]; then
    echo "pre-push: PUSH_SKIP_TESTS=1 — skipping all checks"
    exit 0
fi

if [ "${RELEASE:-0}" = "1" ]; then
    echo "pre-push: RELEASE=1 — full regression (all per-skill suites)"
    bash "$ROOT/scripts/check.sh" --full
    exit $?
fi

if [ "${CHECK:-0}" = "1" ]; then
    echo "pre-push: CHECK=1 — fast gate + suites of skills changed in this push"
    bash "$ROOT/scripts/check.sh" || exit $?
    # changed-skill suites: only skills whose files are in the unpushed commits,
    # only suites that exist — keeps the tier proportional to the change
    changed=$(git diff --name-only "@{push}..HEAD" 2>/dev/null \
        | grep -oE '^skills/[^/]+' | sort -u || true)
    rc=0
    for d in $changed; do
        name=${d#skills/}
        suite="$ROOT/tests/$name/test.sh"
        if [ -x "$suite" ] || [ -f "$suite" ]; then
            echo "── suite: $name ──"
            bash "$suite" || rc=1
        fi
    done
    [ $rc -eq 0 ] && echo "✓ changed-skill suites ok" || echo "✗ suite failures above"
    exit $rc
fi

echo "pre-push: lint + typecheck (fast). Deeper: CHECK=1 (gate) or RELEASE=1 (full)."
bash "$ROOT/scripts/lint.sh"
