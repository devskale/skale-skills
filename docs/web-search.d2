direction: down
title: {
  near: top-center
  label: "web-search — block diagram"
}

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

# ── semantic colour coding ──
web-search: "web-search \"query\" [flags]" { style.fill: "#eef2ff"; style.stroke: "#6366f1"; style.stroke-width: 2 }
launcher: "search launcher (bash)"
search_py: "scripts/search.py"
select: "select_backend()" { shape: diamond; style.fill: "#fff7ed"; style.stroke: "#f59e0b"; style.stroke-width: 2 }
duck: "Duck API" { style.fill: "#ecfeff"; style.stroke: "#06b6d4"; style.stroke-width: 2 }
duck_cred: "WEB_SEARCH_BEARER" { shape: cylinder; style.fill: "#fef3c7"; style.stroke: "#d97706" }
searxng: "SearXNG" { style.fill: "#ecfdf5"; style.stroke: "#10b981"; style.stroke-width: 2 }
searxng_cred: "credgoo searx / SEARXNG_URL" { shape: cylinder; style.fill: "#fef3c7"; style.stroke: "#d97706" }
format: "format_results()"
out: "stdout / stderr" { style.fill: "#f1f5f9"; style.stroke: "#64748b" }

# ── lightweight boxed labels (thin border, light fill, subtle dashed connector) ──
select_note: "--api→Duck · else Duck if token · else public SearXNG" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }
duck_note: "advanced filters: site, filetype, inurl, exclude, exact" { shape: text; style.fill: "#f0f9ff"; style.stroke: "#bae6fd"; style.stroke-width: 1; style.border-radius: 6 }
duck_cred_note: "credgoo → Bearer → amd.skale.dev/api/duck/search" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }
searxng_note: "private first, then public fallback" { shape: text; style.fill: "#f0fdf4"; style.stroke: "#bbf7d0"; style.stroke-width: 1; style.border-radius: 6 }
searxng_cred_note: "private instance · public needs no creds" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }

web-search -> launcher: calls
launcher -> search_py: runs
search_py -> select: select_backend()
select -> duck: --api / token
select -> searxng: default
duck -> duck_cred: needs token
searxng -> searxng_cred: optional
duck -> format: results
searxng -> format: results
format -> out: markdown

# subtle dashed connectors from labels to their node
select_note -> select: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
duck_note -> duck: { style.stroke: "#bae6fd"; style.stroke-dash: 2 }
duck_cred_note -> duck_cred: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
searxng_note -> searxng: { style.stroke: "#bbf7d0"; style.stroke-dash: 2 }
searxng_cred_note -> searxng_cred: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
