direction: down
title: {
  near: top-center
  label: "fetch-url — block diagram"
}

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 101
  }
}

# ── semantic colour coding ──
fetch-url: "fetch-url \"URL\" [flags]" { style.fill: "#eef2ff"; style.stroke: "#6366f1"; style.stroke-width: 2 }
launcher: "fetch-url launcher (bash)"
fetch_py: "scripts/fetch.py"
select: "fetch_url() → tool select" { shape: diamond; style.fill: "#fff7ed"; style.stroke: "#f59e0b"; style.stroke-width: 2 }
dispatch: "fetch_with_fallback()" { style.fill: "#faf5ff"; style.stroke: "#a855f7"; style.stroke-width: 2 }

# ── tool groups: containers with a light summary label ──
local: {
  label: "local text browsers · free"
  style.fill: "#f0fdf4"
  style.stroke: "#bbf7d0"
  style.stroke-width: 1
  w3m: "w3m"
  lynx: "lynx"
  chawan: "chawan"
}
apis: {
  label: "free APIs · no creds"
  style.fill: "#ecfeff"
  style.stroke: "#bae6fd"
  style.stroke-width: 1
  jina: "jina"
  markdown: "markdown"
}
chrome: "chrome" { style.fill: "#fff7ed"; style.stroke: "#fdba74"; style.stroke-width: 1 }
api: "api → amd.skale.dev" { style.fill: "#fffbeb"; style.stroke: "#fcd34d"; style.stroke-width: 1 }
api_cred: "FETCH_URL_BEARER" { shape: cylinder; style.fill: "#fef3c7"; style.stroke: "#d97706" }
out: "cleaned text → stdout" { style.fill: "#f1f5f9"; style.stroke: "#64748b" }

# ── lightweight boxed labels ──
select_note: "auto per site, or --tool override" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }
dispatch_note: "site hints first, then fallback on failure / invalid content" { shape: text; style.fill: "#faf5ff"; style.stroke: "#e9d5ff"; style.stroke-width: 1; style.border-radius: 6 }
chrome_note: "Cloudflare / JS-protected · needs Chrome" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }
api_note: "skale endpoint · needs token" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }
api_cred_note: "credgoo → Bearer" { shape: text; style.fill: "#fffbeb"; style.stroke: "#fde68a"; style.stroke-width: 1; style.border-radius: 6 }

fetch-url -> launcher: calls
launcher -> fetch_py: runs
fetch_py -> select: fetch_url()
select -> dispatch: auto / --tool
dispatch -> local
dispatch -> apis
dispatch -> chrome: JS/Cloudflare
dispatch -> api: needs token
api -> api_cred: credgoo
w3m -> out
lynx -> out
chawan -> out
jina -> out
markdown -> out
chrome -> out
api -> out

# subtle dashed connectors from labels to their node
select_note -> select: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
dispatch_note -> dispatch: { style.stroke: "#e9d5ff"; style.stroke-dash: 2 }
chrome_note -> chrome: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
api_note -> api: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
api_cred_note -> api_cred: { style.stroke: "#fde68a"; style.stroke-dash: 2 }
